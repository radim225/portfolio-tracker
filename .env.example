# Trading 212 API key — generate in the T212 app → Settings → API.
# Single-key (legacy) auth: sent as Authorization: <key> (no "Bearer"/"Basic" prefix).
T212_API_KEY=

# Neon Postgres connection string — from neon.tech dashboard.
# Both the pooled and direct URLs work; pooled is recommended for Vercel serverless.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Optional: "live" (default) or "demo" to point at the paper-trading API.
T212_ENV=live
